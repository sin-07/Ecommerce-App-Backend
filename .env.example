PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/b2b_ecommerce?retryWrites=true&w=majority
JWT_SECRET=your_production_jwt_secret_here
JWT_EXPIRES_IN=7d

# Cloudinary Storage for Real Product Images Uploaded by Admin
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
USE_CLOUDINARY=true

# Transactional Email Verification (Gmail App Password or SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Single Real Admin Account Configuration
ADMIN_EMAIL=admin@apenterprises.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=AP Enterprises Admin
ADMIN_COMPANY=AP Enterprises

# CORS Allowed Origins
CLIENT_URL=https://ecommerce-app-frontend-six-olive.vercel.app
DNS_SERVERS=8.8.8.8,1.1.1.1
